{
  "uid": "otel-lab-sli",
  "title": "OTel Lab — SLIs y salud del pipeline",
  "tags": [
    "opentelemetry",
    "sli",
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "SLI 1 — Tasa de peticiones (req/s)",
      "type": "timeseries",
      "description": "Throughput HTTP por servicio (golden signal: traffic)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_duration_milliseconds_count[1m]))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "SLI 2 — Tasa de errores (%)",
      "type": "timeseries",
      "description": "Porcentaje de respuestas 5xx (golden signal: errors)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "100 * (sum by (job) (rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m])) or sum by (job) (rate(http_server_duration_milliseconds_count[5m])) * 0) / sum by (job) (rate(http_server_duration_milliseconds_count[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "SLI 3 — Latencia p99 / p95 / p50 (ms)",
      "type": "timeseries",
      "description": "Latencia de servidor por percentil (golden signal: latency)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])))",
          "legendFormat": "p99 {{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])))",
          "legendFormat": "p95 {{job}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])))",
          "legendFormat": "p50 {{job}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "SLI 4 — Órdenes procesadas y stock (negocio)",
      "type": "timeseries",
      "description": "Métricas custom de negocio emitidas con el OTel SDK",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (sku) (rate(orders_processed_total[5m])) * 60",
          "legendFormat": "órdenes/min {{sku}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum (rate(inventory_stock_checks_total[5m])) * 60",
          "legendFormat": "chequeos stock/min",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU del OTel Collector (%)",
      "type": "timeseries",
      "description": "Saturación del pipeline de telemetría",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(otelcol_process_cpu_seconds{job=\"otel-collector-internal\"}[1m]) * 100",
          "legendFormat": "CPU collector",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Errores del OTel Collector (envíos fallidos / rechazos)",
      "type": "timeseries",
      "description": "Salud del pipeline: fallos de exportación y rechazos por backpressure",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[5m]))",
          "legendFormat": "spans fallidos {{exporter}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_metric_points[5m]))",
          "legendFormat": "métricas fallidas {{exporter}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records[5m]))",
          "legendFormat": "logs fallidos {{exporter}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (receiver) (rate(otelcol_receiver_refused_spans[5m]))",
          "legendFormat": "spans rechazados {{receiver}}",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    }
  ]
}